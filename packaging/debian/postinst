#!/bin/bash
set -e

. /usr/share/debconf/confmodule

CONFIG_DIR="/etc/somasave-client"
CONFIG_FILE="$CONFIG_DIR/client.conf"
ENV_FILE="/etc/somasave/env"

if [ "$1" = "configure" ]; then

    # Read debconf answers
    db_get somasave-client/github_pat
    GITHUB_PAT="$RET"

    db_get somasave-client/github_owner
    GITHUB_OWNER="$RET"

    db_get somasave-client/github_repo
    GITHUB_REPO="$RET"

    

    # Write client config — non-sensitive settings
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" << EOF
# SomaSave Client Configuration
# Generated by somasave-client package
# Edit with: sudo dpkg-reconfigure somasave-client

EOF

    chmod 644 "$CONFIG_FILE"

    # Write environment file — sensitive values
    mkdir -p /etc/somasave
    cat > "$ENV_FILE" << EOF
GITHUB_PAT=${GITHUB_PAT}
GITHUB_OWNER=${GITHUB_OWNER}
GITHUB_REPO=${GITHUB_REPO}

EOF

    # Lock down the env file
    chmod 600 "$ENV_FILE"
    chown root:root "$ENV_FILE"

    # Clear sensitive values from debconf
    db_reset somasave-client/github_pat         || true
    db_reset somasave-client/github_owner        || true
    db_reset somasave-client/github_repo          || true

    echo ""
    echo "=============================================="
    echo "somasave-client installed successfully."
    echo ""
    echo "Next steps:"
    echo ""
    echo "  1. Run the installer:"
    echo "       sudo somasave install"
    echo ""
    echo "  2. Check status anytime:"
    echo "       sudo somasave status"
    echo "=============================================="
fi

exit 0