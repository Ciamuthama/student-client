#!/bin/bash
set -e

. /usr/share/debconf/confmodule

CONFIG_DIR="/etc/somasave-client"
CONFIG_FILE="$CONFIG_DIR/client.conf"
ENV_FILE="/etc/somasave/env"

if [ "$1" = "configure" ]; then

    # Read debconf answers
    db_get somasave-client/github_pat
    GITHUB_PAT="$RET"

    db_get somasave-client/db_host
    DB_HOST="$RET"

    db_get somasave-client/db_user
    DB_USER="$RET"

    db_get somasave-client/db_password
    DB_PASSWORD="$RET"

    db_get somasave-client/keystore_password
    KEYSTORE_PASSWORD="$RET"

    db_get somasave-client/truststore_password
    TRUSTSTORE_PASSWORD="$RET"

    db_get somasave-client/admin_password
    ADMIN_PASSWORD="$RET"

    # Write client config — non-sensitive settings
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" << EOF
# SomaSave Client Configuration
# Generated by somasave-client package
# Edit with: sudo dpkg-reconfigure somasave-client

GITHUB_OWNER=ciamuthama
GITHUB_REPO=somasaveapi
EOF

    chmod 644 "$CONFIG_FILE"

    # Write environment file — sensitive values
    mkdir -p /etc/somasave
    cat > "$ENV_FILE" << EOF
GITHUB_PAT=${GITHUB_PAT}
DB_HOST=${DB_HOST}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
KEYSTORE_PASSWORD=${KEYSTORE_PASSWORD}
TRUSTSTORE_PASSWORD=${TRUSTSTORE_PASSWORD}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
EOF

    # Lock down the env file
    chmod 600 "$ENV_FILE"
    chown root:root "$ENV_FILE"

    # Clear sensitive values from debconf
    db_reset somasave-client/github_pat         || true
    db_reset somasave-client/db_password        || true
    db_reset somasave-client/keystore_password  || true
    db_reset somasave-client/truststore_password || true
    db_reset somasave-client/admin_password     || true

    echo ""
    echo "=============================================="
    echo "somasave-client installed successfully."
    echo ""
    echo "Next steps:"
    echo "  1. Place your SSL certificates in /etc/somasave/certs/"
    echo "       server.p12"
    echo "       truststore.p12"
    echo "       ca.crt"
    echo "       ca.key"
    echo ""
    echo "  2. Run the installer:"
    echo "       sudo somasave install"
    echo ""
    echo "  3. Check status anytime:"
    echo "       sudo somasave status"
    echo "=============================================="
fi

exit 0